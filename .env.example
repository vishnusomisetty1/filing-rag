# Local DeepSeek V4 Flash on the Spark (vLLM, OpenAI-compatible, no auth)
LLM_BASE_URL=http://spark.tail78e47b.ts.net:8888/v1
LLM_MODEL=deepseek-v4-flash-dspark

# Required by SEC EDGAR: a real contact name + email
SEC_USER_AGENT="Your Name you@example.com"

# Optional: OpenAI-compatible embeddings endpoint (e.g. LiteLLM `embed` alias).
# Unset = Chroma's built-in ONNX all-MiniLM-L6-v2, in-process on CPU.
# EMBED_BASE_URL=
# EMBED_MODEL=embed

# llm (default) | cross-encoder | none
RERANKER=llm
